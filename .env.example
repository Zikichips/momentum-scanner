# Copy to .env for local runs. In GitHub Actions and Vercel these are set as secrets/env vars.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # scanner uses service role (server-side only, never in the dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # dashboard uses anon key (read-only via RLS policies)

# Telegram (create a bot with @BotFather, then get your chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: news check for the footprint screener
CRYPTOPANIC_TOKEN=
NEWSAPI_KEY=

# Optional: CoinMarketCal for catalyst calendar
COINMARKETCAL_KEY=
# Optional: Upbit notices via the spike worker relay (Upbit blocks GitHub Actions IPs).
UPBIT_RELAY_URL=
UPBIT_RELAY_TOKEN=
