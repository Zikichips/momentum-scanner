{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "esnext"], "jsx": "preserve", "module": "esnext",
    "moduleResolution": "bundler", "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "isolatedModules": true, "incremental": true, "noEmit": true,
    "paths": { "@/*": ["./*"] }, "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"], "exclude": ["node_modules"]
}
